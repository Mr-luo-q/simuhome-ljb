# 白名单模式：先忽略根目录下的一切，再逐个放行要跟踪的目录。
# 没被放行的目录不入库，但会在 source.md 里登记来源与体积。
/*
!/.gitignore
!/README.md
!/source.md
!/finally new paper/
!/ha_mcp_server/
!/ha_mcp_universal/
!/simuhome_mqtt_publisher/
!/old_simuhome_bridge_project/
!/_tools/
!/context/
!/deploy/

# 通用排除
__pycache__/
*.pyc
.env
.venv/

# 体积大、不入库的内容（source.md 里有登记）
*.pdf
/_tools/mqtt/*.exe
/_tools/mqtt/wheels/

# 运行时日志：桥接进程还在跑，日志每几秒就变；保留操作记录，忽略标准输出与错误
/old_simuhome_bridge_project/logs/*.log

# 本地机密：HA 长期令牌、MCP 令牌等，永不入库
/_secrets/

# MCP server 的本地配置（含令牌占位）与运行时数据
/ha_mcp_server/config.yaml
/ha_mcp_server/data/

# v2 分叉（通用化接入）：同样是本地配置与运行时数据不入库
/ha_mcp_universal/config.yaml
/ha_mcp_universal/data/
/ha_mcp_universal/.env

# MQTT 工程的运行时日志
/simuhome_mqtt_publisher/logs/

# MQTT 凭据与密码文件
/simuhome_mqtt_publisher/broker/mosquitto.credentials.txt
/simuhome_mqtt_publisher/broker/mosquitto.passwd

# 已退役、不再跟踪也不再参考的目录
/oldmcp/

# 明确排除的外部大目录（本来也不会被放行，写出来是为了可读）
/.git_old_20260917/
/.claude/
/.vscode/
/tdp-nlu-private-main/
/sandbox/
/ha_core_official/
/simuprocject/
/related paper/
/milocoproject/
/homebenchproject/
/sageproject/
/qixuancai_papers/
